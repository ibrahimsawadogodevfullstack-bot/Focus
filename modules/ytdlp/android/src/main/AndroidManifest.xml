<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Téléchargements longs : le service de premier plan empêche Android de
       geler le processus (app freezer / Doze), le wake lock garde le CPU
       éveillé quand l'écran s'éteint. Ce manifeste est fusionné dans celui de
       l'application, y compris après une régénération par expo prebuild. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- yt-dlp embarque ses bibliothèques natives sous forme de fichiers :
       Android doit les extraire à l'installation (useLegacyPackaging). -->
  <application android:extractNativeLibs="true">
    <service
      android:name="expo.modules.ytdlp.YtdlpDownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
